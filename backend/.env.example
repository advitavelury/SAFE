SAFE_FIREBASE_ENABLED=true
SAFE_ZONE_ID=A
FIREBASE_INCIDENTS_COLLECTION=incidents
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/firebase-service-account.json
# Optional local red-event clips. Never put recordings in a public/static folder.
SAFE_RECORDINGS_ENABLED=false
SAFE_RECORDINGS_DIR=/absolute/private/path/to/recordings
