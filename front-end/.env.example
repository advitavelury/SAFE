VITE_FIREBASE_API_KEY=your_safe_ddacb_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=safe-ddacb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=safe-ddacb
VITE_FIREBASE_STORAGE_BUCKET=safe-ddacb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_safe_ddacb_sender_id
VITE_FIREBASE_APP_ID=your_safe_ddacb_web_app_id
VITE_FIREBASE_INCIDENTS_COLLECTION=incidents

# Optional legacy facility camera API origin. Leave blank for the browser demo.
# scripts/run_demo.py supplies the local browser detector/clip origin at runtime.
# Production requires an explicitly configured HTTPS backend and a rebuild.
VITE_MEDIA_API_ORIGIN=

# Browser detector and local incident playback. Leave blank when using the launcher.
# For Vercel, set the authenticated laptop tunnel's HTTPS origin before rebuilding.
VITE_BROWSER_DETECTOR_ORIGIN=
