rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'operator'];
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isApprovedStaff();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
